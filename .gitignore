# Runtime search logs (regenerable; do not commit machine/session-specific logs)
/logs/

# Local/generated data only; keep the canonical cumulative ledger under version control
/data/cache/
/data/tmp/
/data/*.local.jsonl
/data/*.tmp
/data/job_match_evaluations.jsonl

# Python runtime artifacts
__pycache__/
*.py[cod]

# Generated latest-run summary (rebuild from search logs and cumulative ledger)
/reports/latest_run_summary.md

# Local environment configuration and secrets; never commit real credentials
.env
.env.*
!.env.example
!.env.*.example
/secrets/
/credentials.local.*
/secrets.local.*
*.secret
