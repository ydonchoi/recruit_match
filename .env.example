# recruit_match operations configuration template
# Copy into the runtime secret manager/environment; never commit actual credentials.

# One shared Bing Web Search-compatible JSON API. The endpoint must return
# webPages.value[].{url,name,snippet}; exact hostname must be allowlisted.
RECRUIT_MATCH_SEARCH_ENDPOINT=
RECRUIT_MATCH_SEARCH_API_KEY=
RECRUIT_MATCH_SEARCH_ALLOWED_HOSTS=

# Optional public HTML discovery. Enable a platform only after an operator has
# reviewed the site's terms and crawl policy. Do NOT set terms_reviewed=true by default.
# JSON array; see docs/operations-readiness.md for platform-specific constraints.
RECRUIT_MATCH_CRAWL_CONFIG_JSON=

# Required analysis service contract. A single HTTPS service implements:
# POST /v1/opportunity-state-resolution
# POST /v1/assessment-resolution
# POST /v1/revalidation
# Each response must be a JSON object. Configure a real endpoint and secret.
RECRUIT_MATCH_ANALYSIS_SERVICE_BASE_URL=
RECRUIT_MATCH_ANALYSIS_SERVICE_ALLOWED_HOSTS=
RECRUIT_MATCH_ANALYSIS_SERVICE_TOKEN=
RECRUIT_MATCH_ANALYSIS_SERVICE_TIMEOUT_SECONDS=20
